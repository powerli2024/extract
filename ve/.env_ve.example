# 复制为 .env_ve 后按需改（.env_ve 不进 git）
export VE_ROOT="/root/extract-sep/ve"
export PYTHON_BIN="/root/miniconda3/envs/ve/bin/python"
export CLEARVOICE_PYTHON="$PYTHON_BIN"
export VM_CONDA_ENV="${VM_CONDA_ENV:-ve}"
export VE_OUT_BASE="/root/autodl-tmp/ve"
export VE_MODEL_DIR="/root/autodl-tmp/ve_models"
export DATA_DIR="/root/autodl-tmp/datasetA"
export BEST_SEP_DIR="/root/autodl-tmp/pos_neg/best_sep"
export HF_HOME="/root/autodl-tmp/cache/huggingface"
export TORCH_HOME="/root/autodl-tmp/cache/torch"
export MODELSCOPE_CACHE="/root/autodl-tmp/cache/modelscope"
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
export OMP_NUM_THREADS="16"
export MKL_NUM_THREADS="16"
export PIPELINE="${PIPELINE:-mix}"
export ENROLL_VAD="${ENROLL_VAD:-0}"
export LOCKED_THR="${LOCKED_THR:-1}"
export EXTRA_REJECT="${EXTRA_REJECT:-1}"
export PS4_WEIGHTS="${PS4_WEIGHTS:-/root/autodl-tmp/ve_models/PS4/checkpoint_epoch037.pt}"
export SPK_CHS_DIR="${SPK_CHS_DIR:-/root/autodl-tmp/ve_models/cnceleb_resnet34_LM}"
export ERES2NET_DIR="${ERES2NET_DIR:-/root/autodl-tmp/ve_models/eres2netv2_zh}"
export WESEP_ROOT="${WESEP_ROOT:-/root/autodl-tmp/ve_models/wesep}"
export MOSS_ONNX_PATH="${MOSS_ONNX_PATH:-/root/autodl-tmp/checkpoints/MossFormer2_ONNX/simple_model.onnx}"
